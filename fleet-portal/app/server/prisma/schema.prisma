generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite не поддерживает нативные enum — роли и статусы храним как String
// и валидируем на уровне приложения (см. src/types.ts, zod-схемы в модулях).

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  // Увеличивается при смене пароля/блокировке — все ранее выданные токены
  // с меньшей версией сразу перестают приниматься сервером (отзыв сессий).
  tokenVersion Int      @default(0)
  driverId     Int?     @unique
  driver       Driver?  @relation(fields: [driverId], references: [id])
  createdAt    DateTime @default(now())
}

model Driver {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String?
  isActive  Boolean  @default(true)
  user      User?
  trips     Trip[]
  createdAt DateTime @default(now())
}

model Truck {
  id                   Int                 @id @default(autoincrement())
  name                 String
  plateNumber          String
  capacityTons         Float?
  normConsumptionMin   Float?
  normConsumptionMax   Float?
  serviceIntervalKm    Float?
  serviceIntervalDays  Int?
  lastServiceDate      DateTime?
  lastServiceOdometer  Float?
  insuranceExpiryDate  DateTime?
  inspectionExpiryDate DateTime?
  serviceNote          String?
  isActive             Boolean             @default(true)
  trips                Trip[]
  withdrawals          FuelWithdrawal[]
  maintenanceRecords   MaintenanceRecord[]
  createdAt            DateTime            @default(now())
}

model FuelType {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  isActive    Boolean          @default(true)
  lots        FuelLot[]
  withdrawals FuelWithdrawal[]
  createdAt   DateTime         @default(now())
}

model FuelLot {
  id               Int      @id @default(autoincrement())
  fuelType         FuelType @relation(fields: [fuelTypeId], references: [id])
  fuelTypeId       Int
  date             DateTime
  litersIn         Float
  litersRemaining  Float
  pricePerLiter    Float
  totalAmount      Float
  // Сколько из totalAmount ещё не списано FIFO-заправками. Последнее
  // списание, которое полностью опустошает партию, забирает весь остаток
  // (а не litersUsed*pricePerLiter) — так сумма всех списаний с партии
  // всегда точно равна totalAmount, без накопленной ошибки округления
  // (см. computeFifoConsumption в lib/fifo.ts).
  valueRemaining   Float
  supplier         String?
  comment          String?
  createdBy        Int
  createdAt        DateTime @default(now())
  usages           FuelWithdrawalLotUsage[]

  @@index([fuelTypeId, date])
}

model FuelWithdrawal {
  id              Int      @id @default(autoincrement())
  fuelType        FuelType @relation(fields: [fuelTypeId], references: [id])
  fuelTypeId      Int
  date            DateTime
  liters          Float
  isPersonal      Boolean  @default(false)
  truck           Truck?   @relation(fields: [truckId], references: [id])
  truckId         Int?
  odometer        Float?
  personalComment String?
  // Ключ идемпотентности от клиента — повторная отправка той же формы
  // (двойной клик, ретрай при потере ответа) не создаёт вторую запись.
  idempotencyKey  String?  @unique
  totalCost       Float
  createdBy       Int
  createdAt       DateTime @default(now())
  tripId          Int?
  trip            Trip?    @relation(fields: [tripId], references: [id])
  lotUsages       FuelWithdrawalLotUsage[]

  @@index([date, fuelTypeId, truckId])
}

model FuelWithdrawalLotUsage {
  id                 Int            @id @default(autoincrement())
  withdrawal         FuelWithdrawal @relation(fields: [withdrawalId], references: [id])
  withdrawalId       Int
  lot                FuelLot        @relation(fields: [lotId], references: [id])
  lotId              Int
  litersUsed         Float
  pricePerLiterAtUse Float
}

model Trip {
  date            DateTime
  id              Int              @id @default(autoincrement())
  driver          Driver           @relation(fields: [driverId], references: [id])
  driverId        Int
  truck           Truck            @relation(fields: [truckId], references: [id])
  truckId         Int
  routeFrom       String
  routeTo         String
  cargoDescription String?
  cargoJson       String?
  status          String           @default("ASSIGNED")
  createdBy       Int
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fuelWithdrawals FuelWithdrawal[]

  @@index([driverId, status, date])
}

// type: "SERVICE" (плановое ТО) | "REPAIR" (внеплановый ремонт)
model MaintenanceRecord {
  id          Int               @id @default(autoincrement())
  truck       Truck             @relation(fields: [truckId], references: [id])
  truckId     Int
  type        String
  date        DateTime
  odometer    Float
  description String?
  totalCost   Float
  createdBy   Int
  createdAt   DateTime          @default(now())
  parts       MaintenancePart[]

  @@index([truckId, date])
  @@index([type, date])
}

model MaintenancePart {
  id       Int               @id @default(autoincrement())
  record   MaintenanceRecord @relation(fields: [recordId], references: [id])
  recordId Int
  name     String
  cost     Float
}

// ---------- Документы: акты/реестр/счёт по перевозкам для заказчика ----------

model Address {
  id          Int           @id @default(autoincrement())
  code        String?
  fullAddress String        @unique
  // Группировка/сортировка в справочнике — берём как есть из колонки
  // "Направление" исходного файла заказчика (не используется для тарифов,
  // только для удобства навигации по списку адресов).
  city        String
  isActive    Boolean       @default(true)
  rates       AddressRate[]
  deliveries  Delivery[]
  createdAt   DateTime      @default(now())

  @@index([city])
}

model AddressRate {
  id            Int      @id @default(autoincrement())
  address       Address  @relation(fields: [addressId], references: [id])
  addressId     Int
  pricePerKg    Float
  // Тариф действует с этой даты (включительно) до effectiveFrom следующей
  // по времени строки этого же адреса — тариф на конкретный адрес может
  // меняться в течение месяца, проверка всегда берёт тариф, действовавший
  // на дату конкретного рейса, а не "текущий".
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([addressId, effectiveFrom])
}

// Две строки-синглтона: role="SUPPLIER" (Исполнитель/Поставщик) и
// role="BUYER" (Заказчик/Покупатель) — редактируемые реквизиты для шапок
// актов и счёта. kpp и договорные поля релевантны в основном для BUYER,
// банковские реквизиты и dispatchPoint — для SUPPLIER.
model OrgProfile {
  id             Int       @id @default(autoincrement())
  role           String    @unique
  name           String
  inn            String
  kpp            String?
  legalAddress   String
  phone          String?
  bankName       String?
  bankAccount    String?
  bik            String?
  corrAccount    String?
  // "Точка отправки" в акте — фиксированный адрес склада-отправителя.
  dispatchPoint  String?
  contractNumber String?
  contractDate   DateTime?
  contractIgk    String?
  // Строка поля "Поставщик" в счёте на оплату — короче полного блока
  // реквизитов из акта (без телефона/банка, часто с сокращённым ФИО).
  // Если пусто — используется тот же блок, что и в "Исполнитель:" акта.
  invoiceSupplierLine String?
  // Сокращённое ФИО для подписей и блока "Исполнитель:" (напр. "ИП Царюк
  // А. Б.") — во всех примерах документов используется оно, а не полное имя
  // из поля name. Если пусто — используется name как есть.
  shortName           String?
  updatedAt      DateTime  @updatedAt
}

model ImportBatch {
  id             Int        @id @default(autoincrement())
  periodFrom     DateTime
  periodTo       DateTime
  sourceFileName String
  rowCount       Int
  totalMassKg    Float
  totalCost      Float
  createdBy      Int
  createdAt      DateTime   @default(now())
  // Меняется на "Заменить файл" — совпадает с createdAt, пока импорт ни разу
  // не заменяли. Показываем в UI только когда отличается от createdAt.
  updatedAt      DateTime   @updatedAt
  // Сам присланный .xlsx — чтобы можно было скачать и посмотреть, какой
  // именно файл сейчас лежит в основе рейсов за этот период. У импортов,
  // сделанных до этого поля, будет null — на UI для них кнопки скачивания нет.
  fileData       Bytes?
  deliveries     Delivery[]

  @@index([periodFrom, periodTo])
}

model Delivery {
  id            Int         @id @default(autoincrement())
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
  importBatchId Int
  date          DateTime
  address       Address     @relation(fields: [addressId], references: [id])
  addressId     Int
  truckPlate    String
  distanceKm    Float
  massKg        Float
  // Тариф, применённый при проверке этой строки (для аудита — при генерации
  // документов используем именно его, а не пересчитываем заново).
  ratePerKg     Float
  cost          Float
  createdAt     DateTime    @default(now())

  @@index([date])
  @@index([truckPlate, date])
}

// Роялти — начисление конкретному получателю (напр. "Роялти 1"), состоящее
// из одного или нескольких условий (RoyaltyCondition): свой процент от суммы
// доставок своего набора машин. Итог по Роялти — сумма его условий; машины
// НЕ обязаны быть уникальны между условиями и между разными Роялти — одна и
// та же доставка может участвовать в расчёте нескольких роялти одновременно
// (разным людям, каждому свой процент — это намеренно, не ошибка).
model Royalty {
  id         Int                @id @default(autoincrement())
  name       String
  // Порядок отображения (Роялти 1, Роялти 2, ...) — задаётся явно, чтобы
  // пользователь мог менять местами через UI, а не полагаться на дату создания.
  order      Int                @default(0)
  conditions RoyaltyCondition[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

// Сопоставление с Delivery — по точному тексту госномера (Delivery.truckPlate),
// без FK на Truck: так же работает группировка в RouteSummaryRow, и один и тот
// же госномер за разные месяцы может относиться к разным реальным машинам в
// парке — здесь это неважно, условие привязано к строке "Гос номер" из файла.
model RoyaltyCondition {
  id         Int      @id @default(autoincrement())
  royalty    Royalty  @relation(fields: [royaltyId], references: [id], onDelete: Cascade)
  royaltyId  Int
  percent    Float
  order      Int      @default(0)
  // JSON-массив госномеров, включённых в условие, напр. ["У703ХО82","А589ВС82"].
  trucksJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([royaltyId])
}

// Создаётся один раз при закрытии месяца — фиксирует номер/дату счёта
// (вводятся вручную, истории для автонумерации нет) и производные
// номер/дату итогового акта, на которые ссылаются реестр, итоговый акт и
// счёт за этот месяц.
model MonthClosing {
  id             Int      @id @default(autoincrement())
  yearMonth      String   @unique
  invoiceNumber  String
  invoiceDate    DateTime
  finalActNumber Int
  finalActDate   DateTime
  createdBy      Int
  createdAt      DateTime @default(now())
}
